# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Generated forge docs (our design docs live in docs/ and are tracked)
docs/book/

# Gas report artifact
gas-report.txt

